# Copy to gateway/.env. Do not commit real values. Expose ONLY through an HTTPS proxy.
GATEWAY_SHARED_SECRET=replace-with-at-least-32-random-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GATEWAY_ENCRYPTION_KEY=replace-with-base64-32-byte-key
ORDERLY_EVENTS_URL=https://PROJECT.supabase.co/functions/v1/orderly/api/whatsapp/gateway/events
GATEWAY_MAX_SESSIONS=10
# Optional: operator-approved WA version tuple. Never auto-adopt the latest tuple.
# GATEWAY_WA_VERSION=2,3000,1234567890
