{
  "name": "orderly-whatsapp-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/dev.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "build:edge": "node scripts/build-edge.mjs",
    "build:cloudflare": "node scripts/build-frontend.mjs",
    "deploy:frontend": "npm run build:cloudflare && wrangler deploy",
    "deploy:backend": "npm run build:edge && supabase functions deploy orderly --use-api",
    "test:edge-runtime": "npm run build:edge && node scripts/test-edge-runtime.mjs",
    "test:pilot-load": "tsx scripts/rehearse-pilot.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src server scripts tests *.json *.ts *.md docs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.50",
    "@ai-sdk/google": "^4.0.65",
    "@ai-sdk/openai": "^4.0.63",
    "@hono/node-server": "^2.1.1",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.95",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7",
    "lucide-react": "^1.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "deno": "^2.9.6",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
