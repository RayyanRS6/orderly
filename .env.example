# Local development works immediately without any credentials.
APP_MODE=demo
# On the Supabase backend, set APP_MODE=live and APP_URL to the exact deployed
# Cloudflare frontend origin, e.g. https://orderly.<your-subdomain>.workers.dev.
# APP_URL must not contain a path. It is used to allow the frontend's requests.
APP_URL=http://127.0.0.1:5173
# The only deployment value needed when building the Cloudflare frontend.
# Leave blank locally to use Vite's /api proxy. Set this before `npm run build`:
# VITE_API_BASE_URL=https://zygsuxgqkeedgcbjhfzx.supabase.co/functions/v1/orderly
VITE_API_BASE_URL=
# With a Supabase VITE_API_BASE_URL: the project's region, so the backend runs beside the
# database instead of near each browser (the hosted build refuses to start without it).
# VITE_API_REGION=ap-southeast-2
VITE_API_REGION=
# Everything below belongs only on the backend. Never prefix secrets with VITE_:
# Vite embeds VITE_ variables into public browser JavaScript.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
# Optional: base64 of at least 32 random bytes for menu page links and order codes. When blank,
# their keys are derived from CREDENTIAL_ENCRYPTION_KEY. Changing it ends links already sent.
MENU_LINK_SECRET=
# There are no server-wide AI keys: each business pastes its own OpenAI, Anthropic or
# Gemini key in Bot settings → AI model, stored encrypted with the key above.
# Set the Graph API version supported by your Meta app, e.g. v23.0.
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
# Shared secret for authenticated worker/recovery calls; keep in Supabase
# backend secrets and Vault for the scheduler, never in Cloudflare build vars.
CRON_SECRET=
# Worker lease in seconds: 180 on Supabase Free (functions stop after 150 s), 480 on Pro.
WORKER_LEASE_SECONDS=180
# Emergency stop: "on" pauses automatic replies for every business. Leave blank (off) normally.
ORDERLY_PAUSE_AUTOMATION=
# Optional: enables /api/health/pipeline for a monitor sending "Authorization: Bearer <token>".
HEALTH_CHECK_TOKEN=
# Additional model prices: {"model-id":[input_USD_per_million,output_USD_per_million]}
MODEL_PRICING_JSON={}
# Optional emergency switch: "off" stops reusing the fixed AI instructions from Anthropic's
# 5-minute prompt cache. The words sent are the same either way.
PROMPT_CACHE=
# Optional staff email alerts. Configure a verified sending address in Resend.
# Staff must separately opt in using their verified Orderly account email.
RESEND_API_KEY=
ALERT_FROM_EMAIL=
# Optional Orderly-owned linked-device gateway. Apply its migration and deploy its
# persistent Node service before enabling. These values are backend-only.
WHATSAPP_GATEWAY_ENABLED=false
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_SECRET=
