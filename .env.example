# Local development works immediately without any credentials.
APP_MODE=demo
# Live deployments must use APP_MODE=live. Demo mode refuses to run on Vercel.
APP_URL=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_ENCRYPTION_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Set the Graph API version supported by your Meta app, e.g. v23.0.
META_GRAPH_VERSION=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_APP_ID=
META_EMBEDDED_SIGNUP_CONFIG_ID=
CRON_SECRET=
# Additional model prices: {"model-id":[input_USD_per_million,output_USD_per_million]}
MODEL_PRICING_JSON={}
